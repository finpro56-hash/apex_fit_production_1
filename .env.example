# ==============================================================================
# APEX FIT — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# 1. Never commit real API keys, credentials, or service account secrets to Git.
# 2. Variables prefixed with VITE_ are embedded into client JavaScript bundles at build time.
# 3. Server secrets must NEVER use the VITE_ prefix.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-ONLY SECRETS (Required on Vercel Production, Preview, and Local Dev)
# ------------------------------------------------------------------------------

# Gemini API Key (Required for all AI endpoints)
# Environments: Vercel Production, Vercel Preview, Local Dev
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyPlaceholder"

# Canonical Hosted Application URL
# Used for CORS allowed origins, OAuth callbacks, and self-referential links.
# Environments: Vercel Production (e.g. https://apexfit.vercel.app), Vercel Preview, Local Dev
APP_URL="http://localhost:3000"

# Optional Gemini & Rate Limiting Overrides
# Environments: Optional in all environments (defaults: gemini-3.8-flash / 40 req/hr)
# GEMINI_MODEL="gemini-3.8-flash"
# GEMINI_FALLBACK_MODELS="gemini-flash-latest,gemini-3.1-flash-lite"
# AI_REQUESTS_PER_HOUR=40

# Server-Side Firebase Admin Authentication
# Used to verify Firebase ID tokens sent by authenticated users.
# Environments:
#   - Google Cloud / Cloud Run: Uses Application Default Credentials automatically.
#   - Vercel (Production & Preview): Set FIREBASE_PROJECT_ID and EITHER:
#       Option A: FIREBASE_SERVICE_ACCOUNT_JSON (full JSON string)
#       Option B: FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-firebase-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# Option A alternative:
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","client_email":"...","private_key":"..."}'

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE PUBLIC FIREBASE CONFIGURATION (Vite Client Bundles)
# ------------------------------------------------------------------------------
# Priority:
#   1. When set in environment variables (VITE_FIREBASE_*), these take highest precedence.
#      Recommended for Vercel Production and Preview to dynamically target staging/prod.
#   2. When omitted in local development, the app automatically falls back to the
#      provisioned firebase-applet-config.json file.
# Environments: Vercel Production, Vercel Preview, Local Dev (optional if JSON present)

VITE_FIREBASE_API_KEY="AIzaSyYourClientWebApiKeyPlaceholder"
VITE_FIREBASE_AUTH_DOMAIN="your-firebase-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-firebase-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# Firestore Named Database ID (Optional)
# If using the default Firestore database, omit this or leave as "(default)".
# If using a specific provisioned database (e.g. in AI Studio), provide its ID.
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
